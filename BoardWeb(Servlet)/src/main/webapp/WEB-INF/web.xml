<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" id="WebApp_ID" version="6.0">
  <display-name>BoardWeb(Servlet)</display-name>
  <welcome-file-list>
    <welcome-file>login.html</welcome-file>
  </welcome-file-list>
  <context-param>
    <param-name>ApplicationName</param-name>
    <param-value>MyBoard Web.</param-value>
  </context-param>
  <servlet>
    <servlet-name>insertUser</servlet-name>
    <servlet-class>com.multicampus.web.user.InsertUserServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>insertUser</servlet-name>
    <url-pattern>/insertUser.do</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>insertBoard</servlet-name>
    <servlet-class>com.multicampus.web.board.InsertBoardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>insertBoard</servlet-name>
    <url-pattern>/insertBoard.do</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>getBoardList</servlet-name>
    <servlet-class>com.multicampus.web.board.GetBoardListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>getBoardList</servlet-name>
    <url-pattern>/getBoardList.do</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>getBoard</servlet-name>
    <servlet-class>com.multicampus.web.board.GetBoardServlet</servlet-class>
    <init-param>
      <param-name>Author</param-name>
      <param-value>ANSMOON</param-value>
    </init-param>
    <init-param>
      <param-name>CreateDate</param-name>
      <param-value>2025-07-09</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>getBoard</servlet-name>
    <url-pattern>/getBoard.do</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>updateBoard</servlet-name>
    <servlet-class>com.multicampus.web.board.UpdateBoardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>updateBoard</servlet-name>
    <url-pattern>/updateBoard.do</url-pattern>
  </servlet-mapping>
</web-app>